#!/usr/bin/env bash

# grid_fixtures.sh: provides grid initialization and array population for diamond pattern
source ./grid_fixtures.sh
grid_fixtures::init

# Inits (Even grid 8)
# grid_size=8
# half=$(( grid_size /2 ))
# #    { 0 1 2 3 4 5 6 7 }
# l_Pos=(3 2 1 0 0 1 2 3)
# r_Pos=(4 5 6 7 7 6 5 4)
# line="        "

# Outputs error message prefixed with calling function stack
# Globals: none
# Args: $1=error_string
# Outputs: formatted error to stderr
# Returns: none
_call_error() {
  local error_string="$1"
  echo "${FUNCTNAME[@]},${error_string}" >&2
}

# Replaces character at given index in a string
# Globals: none
# Args: $1=input_string; $2=index (0-based); $3=replacement_char
# Outputs: modified string to stdout
# Returns: 0 on success
replace_character() {
  local in_line="$1"
  local in_index="$2"
  local in_char="$3"

  local out_line="${in_line:0:$in_index}$in_char${in_line:$(($in_index + 1))}"
  echo "$out_line"
}

# Generates grid diamond pattern by placing left and right characters at mirrored positions
# Globals: grid_size (required), half (required), l_Pos (required), r_Pos (required), line (required)
# Args: none
# Outputs: grid_size lines with diamond pattern to stdout
# Returns: 0 on success
basegrid() {
  local lchr="/"
  local rchr="\\"

  local i
  for ((i=0; i < grid_size; i++)); do
    (( i == half )) && {
      local tval="$rchr"
      rchr="$lchr"
      lchr="$tval"
    }
    local tline="$line"
    tline="$(replace_character "$tline" "${l_Pos[$i]}" "$lchr")"
    tline="$(replace_character "$tline" "${r_Pos[$i]}" "$rchr")"
    echo "$tline"
  done
}
basegrid
